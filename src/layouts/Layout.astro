---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { NOM_SITE, IMAGE_DEFAUT, urlAbsolue, serialiserJsonLd } from '../lib/seo';

interface Props {
  titre:                string;
  description:          string;
  image?:               string;
  typeOg?:              'website' | 'article';
  donneesStructurees?:  object[];
  indexable?:           boolean;
}

const {
  titre,
  description,
  image = IMAGE_DEFAUT,
  typeOg = 'website',
  donneesStructurees = [],
  indexable = true,
} = Astro.props;

const titreComplet  = titre === NOM_SITE ? titre : `${titre} | ${NOM_SITE}`;
const urlCanonique  = urlAbsolue(Astro.url.pathname, Astro.site);
const urlImage      = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {indexable && <link rel="canonical" href={urlCanonique} />}
    <meta name="generator" content={Astro.generator} />

    <!-- SEO principal -->
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />

    <!-- Open Graph -->
    <meta property="og:type"        content={typeOg} />
    <meta property="og:url"         content={urlCanonique} />
    <meta property="og:title"       content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={urlImage} />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:site_name"   content={NOM_SITE} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={urlImage} />

    <!-- Données structurées -->
    {donneesStructurees.map((donnees) => (
      <script type="application/ld+json" set:html={serialiserJsonLd(donnees)} />
    ))}

    <!-- Typographie serif haut de gamme -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />

    <!-- Slot head : pour injecter des scripts/styles supplémentaires par page -->
    <slot name="head" />
  </head>

  <body class="bg-white text-ardoise-900 antialiased">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <SpeedInsights />
  </body>
</html>
