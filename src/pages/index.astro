---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoSrcComplet from '../assets/logo complet.svg';
import { getCollection } from 'astro:content';

const derniersProjets = (await getCollection('projets'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const derniersArticles = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

function formaterDate(date: Date): string {
  return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  titre="BNZ Toitures — Couvreur-Zingueur artisan dans le Grand Ouest"
  description="BNZ Toitures réalise vos projets de rénovation d'excellence et de zinguerie sur-mesure dans le Grand Ouest. Diagnostic d'expert, compagnons locaux qualifiés, Garantie Décennale."
>

  <!-- ═══════════════════════════════════════════
       SECTION HÉRO
  ═══════════════════════════════════════════ -->
  <section
    id="hero"
    class="min-h-screen flex items-center justify-center hero-gradient text-white pt-14 md:pt-20"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 justify-center text-center py-12 sm:py-24">
      <a class="flex w-auto justify-center mb-5 h-36 sm:h-56 md:h-72" href="/" aria-label="BNZ Toitures — accueil">
        <img
          src={logoSrcComplet.src}
          alt="BNZ Toitures"
          height="80"
          class="w-auto"
          loading="eager"
        />
      </a>
      <p class="text-brique-400 font-semibold uppercase tracking-widest text-sm mb-4">
        Artisan couvreur-zingueur · Gironde · Loire Atlantique · Bretagne
      </p>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-serif mb-6 leading-tight">
        L'art de la toiture et du zinc<br />
        <span class="text-brique-500">dans le Grand Ouest.</span>
      </h1>

      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10">
        BNZ Toitures réalise vos projets de rénovation d'excellence et de zinguerie sur-mesure.
        Nous ne faisons pas de volume&nbsp;: chaque chantier bénéficie d'un diagnostic d'expert
        et d'une sélection rigoureuse de compagnons locaux qualifiés.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="tel:0631295662"
          class="inline-flex items-center justify-center gap-2 bg-brique-500 hover:bg-brique-600 text-ardoise-950 font-bold px-8 py-4 rounded-full text-lg transition-colors shadow-lg"
          aria-label="Demander un diagnostic sur site — BNZ Toitures"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          Demander un diagnostic sur site
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center gap-2 border-2 border-white/60 text-white hover:bg-white hover:text-ardoise-950 font-semibold px-8 py-4 rounded-full text-lg transition-colors"
        >
          Nos services ↓
        </a>
      </div>

      <div class="mt-8 inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white text-sm font-medium px-4 py-2 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brique-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd"/>
        </svg>
        Garantie Décennale
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION NOTRE APPROCHE
  ═══════════════════════════════════════════ -->
  <section id="approche" class="py-14 md:py-24 bg-ardoise-950 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <p class="text-brique-400 font-semibold uppercase tracking-widest text-sm mb-3">Notre modèle</p>
      <h2 class="text-3xl sm:text-4xl font-bold font-serif mb-8">Une expertise unique, un seul interlocuteur</h2>
      <p class="text-slate-300 text-lg leading-relaxed max-w-3xl mx-auto">
        Parce que chaque toit est unique, BNZ Toitures refuse la standardisation. Pour chaque projet, nous sélectionnons
        et coordonnons les meilleurs artisans locaux en fonction des exigences techniques de votre bâti. Vous bénéficiez
        de la réactivité et du suivi d'un interlocuteur unique, alliés à la force de frappe de spécialistes de confiance.
        Pas de sous-traitance opaque, uniquement du compagnonnage de métier.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 mt-14">
        <div class="text-center">
          <div class="w-14 h-14 bg-white/5 border border-brique-500/40 rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="text-brique-400 font-bold text-xl font-serif">01</span>
          </div>
          <p class="text-white font-semibold mb-2">Diagnostic d'expert</p>
          <p class="text-slate-400 text-sm leading-relaxed">Une inspection rigoureuse sur site, sans estimation approximative à distance.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-white/5 border border-brique-500/40 rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="text-brique-400 font-bold text-xl font-serif">02</span>
          </div>
          <p class="text-white font-semibold mb-2">Sélection rigoureuse</p>
          <p class="text-slate-400 text-sm leading-relaxed">Les compagnons locaux les mieux adaptés à votre chantier, choisis pour leur maîtrise technique.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-white/5 border border-brique-500/40 rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="text-brique-400 font-bold text-xl font-serif">03</span>
          </div>
          <p class="text-white font-semibold mb-2">Suivi de bout en bout</p>
          <p class="text-slate-400 text-sm leading-relaxed">Un seul interlocuteur du devis à la livraison. Votre tranquillité, notre responsabilité.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION SERVICES
  ═══════════════════════════════════════════ -->
  <section id="services" class="py-14 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <p class="text-brique-600 font-semibold uppercase tracking-widest text-sm text-center mb-3">Savoir-faire</p>
      <h2 class="text-3xl sm:text-4xl font-bold font-serif text-ardoise-900 text-center mb-3">Nos services</h2>
      <p class="text-center text-slate-500 mb-10 md:mb-16 max-w-xl mx-auto">
        De la réfection complète à l'entretien ponctuel, nous intervenons sur tous types de couvertures
        avec les matériaux et les techniques de l'excellence.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <article class="bg-ardoise-50 rounded-2xl p-8 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-ardoise-900 rounded-lg flex items-center justify-center mb-5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brique-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
            </svg>
          </div>
          <h3 class="font-bold font-serif text-ardoise-900 text-xl mb-3">Rénovation de toiture</h3>
          <p class="text-slate-500 text-sm leading-relaxed">
            Ardoise naturelle, tuile terre cuite, tuile béton, bac acier — dépose et repose complète ou partielle.
            Chaque intervention respecte les lignes du bâtiment et son identité architecturale.
            Nous sélectionnons des matériaux de qualité pour garantir durabilité et cohérence patrimoniale.
          </p>
        </article>

        <article class="bg-ardoise-50 rounded-2xl p-8 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-ardoise-900 rounded-lg flex items-center justify-center mb-5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brique-400" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M12 6.75a5.25 5.25 0 016.775-5.025.75.75 0 01.313 1.248l-3.32 3.319c.063.475.276.934.641 1.299.365.365.824.578 1.3.641l3.318-3.319a.75.75 0 011.248.313 5.25 5.25 0 01-5.472 6.756c-1.018-.086-1.87.1-2.309.634L7.344 21.3A3.298 3.298 0 112.7 16.657l8.684-7.151c.533-.44.72-1.291.634-2.309z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-bold font-serif text-ardoise-900 text-xl mb-3">Zinguerie sur-mesure</h3>
          <p class="text-slate-500 text-sm leading-relaxed">
            Gouttières, chéneaux, noues, solins, bavettes et faîtages façonnés à la main en zinc naturel ou prépatiné.
            Soudures à l'étain pour une étanchéité pérenne — aucun profilé plastique.
            Un travail de métal traditionnel, au service de la durabilité de votre bâti.
          </p>
        </article>

        <article class="bg-ardoise-50 rounded-2xl p-8 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-ardoise-900 rounded-lg flex items-center justify-center mb-5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brique-400" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 100 13.5 6.75 6.75 0 000-13.5zM2.25 10.5a8.25 8.25 0 1114.59 5.28l4.69 4.69a.75.75 0 11-1.06 1.06l-4.69-4.69A8.25 8.25 0 012.25 10.5z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-bold font-serif text-ardoise-900 text-xl mb-3">Entretien & Inspection</h3>
          <p class="text-slate-500 text-sm leading-relaxed">
            Nettoyage, traitement hydrofuge, remplacement de tuiles cassées, inspection après tempête.
            Un suivi régulier pour préserver la couverture existante et anticiper les désordres
            avant qu'ils ne deviennent coûteux.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION PROCESSUS
  ═══════════════════════════════════════════ -->
  <section id="processus" class="py-14 md:py-24 bg-ardoise-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <p class="text-brique-600 font-semibold uppercase tracking-widest text-sm text-center mb-3">Comment ça se passe</p>
      <h2 class="text-3xl sm:text-4xl font-bold font-serif text-ardoise-900 text-center mb-3">Du premier contact à la livraison</h2>
      <p class="text-center text-slate-500 mb-10 md:mb-16 max-w-xl mx-auto">
        Pas d'estimation approximative à distance. Un vrai diagnostic, une proposition honnête.
      </p>

      <div class="space-y-10">

        <div class="flex gap-6 items-start">
          <div class="flex-shrink-0 w-12 h-12 bg-ardoise-900 rounded-full flex items-center justify-center text-brique-400 font-bold text-lg font-serif">1</div>
          <div>
            <h3 class="font-bold font-serif text-ardoise-900 text-lg mb-2">Premier contact téléphonique direct</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              Un échange ciblé pour comprendre vos attentes, la nature de votre bâtiment et la problématique précise.
              Pas de formulaire automatisé, pas de réponse standardisée : on parle de votre projet, dès le premier appel.
            </p>
          </div>
        </div>

        <div class="flex gap-6 items-start">
          <div class="flex-shrink-0 w-12 h-12 bg-ardoise-900 rounded-full flex items-center justify-center text-brique-400 font-bold text-lg font-serif">2</div>
          <div>
            <h3 class="font-bold font-serif text-ardoise-900 text-lg mb-2">Déplacement sur site pour un vrai diagnostic</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              Nous nous déplaçons rapidement pour inspecter la toiture dans son intégralité : combles, structure bois,
              évacuations, points de détail. C'est la seule manière d'établir un état des lieux fiable
              et de vous apporter une réponse technique sérieuse.
            </p>
          </div>
        </div>

        <div class="flex gap-6 items-start">
          <div class="flex-shrink-0 w-12 h-12 bg-ardoise-900 rounded-full flex items-center justify-center text-brique-400 font-bold text-lg font-serif">3</div>
          <div>
            <h3 class="font-bold font-serif text-ardoise-900 text-lg mb-2">Proposition claire, détaillée et au juste prix</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              Un devis complet, lisible et transparent, chiffré au juste prix de l'excellence technique.
              Chaque poste est justifié. Nous ne cherchons pas le marché le moins cher — nous cherchons à bien faire.
            </p>
          </div>
        </div>

      </div>

      <div class="mt-14 text-center">
        <a
          href="tel:0631295662"
          class="inline-flex items-center justify-center gap-2 bg-brique-500 hover:bg-brique-600 text-ardoise-950 font-bold px-8 py-4 rounded-full text-lg transition-colors shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          Demander un diagnostic sur site
        </a>
        <p class="text-slate-500 text-sm mt-4 flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ardoise-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.516 2.17a.75.75 0 00-1.032 0 11.209 11.209 0 01-7.877 3.08.75.75 0 00-.722.515A12.74 12.74 0 002.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 00.374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 00-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08zm3.094 8.016a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/>
          </svg>
          Garantie Décennale · Assurance RC Pro
        </p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION RÉALISATIONS (aperçu)
  ═══════════════════════════════════════════ -->
  <section id="projets" class="py-14 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-3xl font-bold font-serif text-ardoise-900 text-center mb-3">Nos réalisations</h2>
      <p class="text-center text-slate-500 mb-10 md:mb-16 max-w-xl mx-auto">
        Photos avant / après — la preuve par l'image de notre savoir-faire artisanal.
      </p>

      {derniersProjets.length === 0 ? (
        <p class="text-center text-slate-400">Aucune réalisation pour le moment.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {derniersProjets.map((projet) => (
            <a href={`/projets/${projet.id}`} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="relative aspect-video bg-ardoise-100">
                <Image
                  src={projet.data.imageApres}
                  alt={`Après rénovation — ${projet.data.title}`}
                  class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 opacity-100 group-hover:opacity-0"
                  width={480}
                  height={270}
                />
                <Image
                  src={projet.data.imageAvant}
                  alt={`Avant rénovation — ${projet.data.title}`}
                  class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 opacity-0 group-hover:opacity-100"
                  width={480}
                  height={270}
                />
                <span class="absolute top-3 left-3 text-white text-xs font-bold px-2.5 py-1 rounded-full transition-all duration-500 bg-brique-500 group-hover:opacity-0">
                  APRÈS
                </span>
                <span class="absolute top-3 left-3 text-white text-xs font-bold px-2.5 py-1 rounded-full transition-all duration-500 bg-ardoise-700 opacity-0 group-hover:opacity-100">
                  AVANT
                </span>
              </div>
              <div class="p-5">
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-1.5">
                  <span>📍 {projet.data.location}</span>
                  <span aria-hidden="true">·</span>
                  <time>{projet.data.date}</time>
                </div>
                <h3 class="font-bold text-ardoise-900 text-base leading-snug">{projet.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a
          href="/projets"
          class="inline-flex items-center gap-2 bg-ardoise-900 hover:bg-ardoise-800 text-white font-semibold px-6 py-3 rounded-full transition-colors"
        >
          Voir toutes les réalisations →
        </a>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION BLOG / CONSEILS (aperçu)
  ═══════════════════════════════════════════ -->
  <section id="blog" class="py-14 md:py-24 bg-ardoise-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-3xl font-bold font-serif text-ardoise-900 text-center mb-3">Conseils & Actualités</h2>
      <p class="text-center text-slate-500 mb-10 md:mb-16 max-w-xl mx-auto">
        Guides pratiques, FAQ et actualités du métier de couvreur-zingueur.
      </p>

      {derniersArticles.length === 0 ? (
        <p class="text-center text-slate-400">Aucun article pour le moment.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {derniersArticles.map((article) => (
            <a
              href={`/blog/${article.id}`}
              class="bg-white rounded-2xl p-6 flex flex-col hover:shadow-md transition-shadow group"
            >
              {article.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-3">
                  {article.data.tags.map((tag) => (
                    <span class="bg-ardoise-100 text-ardoise-700 text-xs font-medium px-2.5 py-1 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <h3 class="font-bold text-ardoise-900 text-lg leading-snug mb-2 group-hover:text-ocean-600 transition-colors">
                {article.data.title}
              </h3>
              <p class="text-slate-600 text-sm flex-1 line-clamp-2 mb-4">{article.data.description}</p>
              <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-ardoise-200">
                <span>📍 {article.data.location}</span>
                <time datetime={article.data.pubDate.toISOString()}>
                  {formaterDate(article.data.pubDate)}
                </time>
              </div>
              <span class="mt-3 text-ocean-600 text-sm font-semibold group-hover:underline">Lire l'article →</span>
            </a>
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 bg-ardoise-900 hover:bg-ardoise-800 text-white font-semibold px-6 py-3 rounded-full transition-colors"
        >
          Lire tous les articles →
        </a>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION CONTACT (CTA bas de page)
  ═══════════════════════════════════════════ -->
  <section id="contact" class="py-14 md:py-24 bg-ardoise-950 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <h2 class="text-3xl sm:text-4xl font-bold font-serif mb-4">Parlons de votre toiture</h2>
      <p class="text-slate-300 mb-6 text-lg">
        Un premier échange suffit souvent à cibler ce dont vous avez besoin.
        Appelez directement ou envoyez un message — sans engagement.
      </p>

      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white text-sm font-medium px-5 py-2.5 rounded-full mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brique-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
